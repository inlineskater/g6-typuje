<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rynek-proroctw.backup</string>

  <!-- Primary time 03:00, plus same-day retry slots. The script's once-per-day
       guard means the FIRST successful run of the day makes the backup and the
       later slots simply skip — but if 03:00 fails (e.g. the Supabase pooler
       drops the dump), 09:00/15:00/21:00 retry instead of losing the whole day.
       If the Mac is ASLEEP at a slot, launchd runs it on the next wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- If the Mac was fully OFF at 03:00, the agent reloads at your next login and
       RunAtLoad fires the job then. The script's once-per-day guard makes this
       safe: it dumps at most once per calendar day, so a missed 03:00 run is
       simply picked up the next time the Mac is on. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Sources ~/.rynek-backup.env (you create it — holds SUPABASE_DB_URL) so no
       secret lives in this file, then runs the backup. Homebrew bin is prepended
       so pg_dump (from `brew install libpq`) is found. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"; source "$HOME/.rynek-backup.env" &amp;&amp; /Users/yuriishavlov/projects/rynek-proroctw/scripts/backup-db.sh</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/yuriishavlov/.rynek-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yuriishavlov/.rynek-backup.log</string>
</dict>
</plist>
